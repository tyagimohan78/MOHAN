# ─────────────────────────────────────────────────────────────────────────────
# NTSO website — environment variables (PLACEHOLDERS ONLY — never commit real values)
# Copy to .env (local) or set in your hosting provider's secret manager.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection string (required)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/ntso?schema=public&sslmode=require"

# Public site URL — used for canonical URLs, sitemap, Open Graph and email links (required in production)
NEXT_PUBLIC_SITE_URL="https://ntso.in"
APP_URL="https://ntso.in"

# Where new-enquiry and new-ticket notifications are sent
SALES_NOTIFY_EMAIL="sales@NTSO.in"
SUPPORT_NOTIFY_EMAIL="sales@NTSO.in"

# Transactional email via SMTP (e.g. Microsoft 365, Amazon SES, Brevo, Postmark, Zoho)
# Leave SMTP_HOST empty to disable email; records are still saved and flagged "not configured".
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"            # "true" for port 465
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="NTSO Private Limited <no-reply@ntso.in>"

# Optional Cloudflare Turnstile bot protection for public forms (both required to enable)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# File storage for ticket attachments and product images: "local" or "s3"
STORAGE_DRIVER="local"
UPLOAD_DIR="./uploads"          # local driver only — must be a persistent volume, outside /public
# S3-compatible storage (AWS S3, Cloudflare R2, DigitalOcean Spaces, MinIO…) — keep the bucket PRIVATE
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""                  # e.g. https://<account>.r2.cloudflarestorage.com (leave empty for AWS)
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
MAX_UPLOAD_MB="5"

# Admin sessions
ADMIN_SESSION_DAYS="7"

# Rate-limit store: "database" (default; shared across instances) or "memory" (single process only)
RATE_LIMIT_STORE="database"

# `npm run maintenance`: also delete audit-log entries older than N days (min 30). Leave empty to keep all.
AUDIT_LOG_RETENTION_DAYS=""

# Optional: header your host/CDN sets to the real visitor IP (e.g. "cf-connecting-ip", "true-client-ip").
# Check Admin → Website settings → Deployment diagnostics after deploying to choose the right one.
CLIENT_IP_HEADER=""

# Set to "false" only if the app is NOT behind a reverse proxy/platform that sets X-Real-IP / X-Forwarded-For.
TRUST_PROXY="true"

# Used only by `npm run admin:create` (set inline on the command line, do not store here)
# ADMIN_EMAIL=""
# ADMIN_PASSWORD=""
# ADMIN_NAME=""
# ADMIN_ROLE="ADMIN"
